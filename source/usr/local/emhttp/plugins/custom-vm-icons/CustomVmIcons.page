#cvi-wrap .cvi-card h3 { margin:0 0 14px; font-size:15px; color:#e8ecf2; font-weight:700; }
#cvi-wrap table { width:100%; border-collapse:collapse; margin-top:10px; }
#cvi-wrap th, #cvi-wrap td { text-align:left; padding:8px 10px; border-bottom:1px solid #2a323f; font-size:13px; }
#cvi-wrap label { white-space:normal; max-width:100%; }
#cvi-wrap input[type=text] { background:#11161e; border:1px solid #2a323f; border-radius:6px;
  color:#d8dee9; padding:8px 10px; font-size:13px; width:100%; max-width:280px; }
#cvi-wrap .cvi-btn { background:#2a323f; color:#d8dee9; border:1px solid #3a4453; border-radius:6px;
  padding:6px 14px; font-size:13px; cursor:pointer; white-space:nowrap; }
#cvi-wrap .cvi-btn.primary { background:#26536f; border-color:#2f6b8f; }
#cvi-wrap .cvi-btn.del { color:#ff8080; }
#cvi-wrap .cvi-del { width:34px; min-width:34px; max-width:34px; padding:6px 0;
  text-align:center; box-sizing:border-box; overflow:hidden; }
#cvi-wrap .cvi-del i { margin:0; }
