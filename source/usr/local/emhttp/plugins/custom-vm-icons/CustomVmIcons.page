  background:#11161e; padding:3px; border:1px solid #2a323f; }
#cvi-wrap .cvi-status { font-size:12px; color:#8993a4; margin-top:8px; }
#cvi-wrap .cvi-msg { margin-top:10px; font-size:13px; display:none; border-radius:6px; padding:8px 12px; }
#cvi-wrap .cvi-msg.ok { display:block; background:rgba(107,203,122,.15); color:#6bcb7a; }
