<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name        "custom-vm-icons">
<!ENTITY author      "KlimasTech">
<!ENTITY version     "2026.11.27">
<!ENTITY launch      "Settings/CustomVmIcons">
<!ENTITY pluginURL   "https://raw.githubusercontent.com/KlimasTech/custom-vm-icons/main/custom-vm-icons.plg">
<!ENTITY packageURL  "https://github.com/KlimasTech/custom-vm-icons/releases/download/&version;/custom-vm-icons-&version;.txz">
<!ENTITY packageMD5  "53c6f4ef1da817dd86101b9b7d61bfe5">
<!ENTITY pluginLOC   "/boot/config/plugins/&name;">
<!ENTITY emhttpLOC   "/usr/local/emhttp/plugins/&name;">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" icon="fa-picture-o">

<CHANGES>
### 2026.11.27
- Poprawka startu systemu: plugin nie tworzy juz /mnt/user/appdata/custom-vm-icons na rootfs przed startem tablicy (katalog w pustym jeszcze /mnt/user psul montowanie udzialow shfs i inne pluginy korzystajace z appdata)
- Synchronizacja przy starcie przez zdarzenie emhttp event/disks_mounted zamiast wpisu w /boot/config/go; stary wpis jest usuwany przy aktualizacji
- sync_icons.sh i endpoint uploadu nic nie zapisuja pod /mnt/user, gdy udzialy nie sa zamontowane
- Instalacja przy starcie systemu nie czeka juz do 5 minut na tablice

### 2026.10.29a
- Dolaczono 7 domyslnych ikon (android, macos, mikrotik, ms-dos, omv, openwrt, proxmox) pobranych z unRAID Backup — seedowane do /mnt/user/appdata/custom-vm-icons przy instalacji, bez nadpisywania wlasnych ikon uzytkownika

### 2026.10.29
- Strona Plugins pokazuje teraz wlasciwa nazwe "Custom VM Icons" z opisem: dodano plik README.md do paczki (unRAID renderuje go jako naglowek/opis wtyczki na liscie)

### 2026.10.28
- Pierwsze wydanie: wgrywanie wlasnych ikon VM (PNG/JPG, automatyczna konwersja do PNG 48x48).
- Ikony przechowywane trwale w /mnt/user/appdata/custom-vm-icons (przezywaja restart serwera),
  automatycznie synchronizowane do VM Managera (katalog ikon dynamix.vm.manager na /boot).
- Automatyczne przywracanie brakujacych ikon przy starcie systemu (po zamontowaniu tablicy).
- Strona zarzadzania: Ustawienia - Custom VM Icons (upload, podglad, usuwanie, sync/reczne przywracanie).
</CHANGES>

<!-- PRZYGOTOWANIE -->
<FILE Run="/bin/bash">
<INLINE>
mkdir -p &pluginLOC;
rm -f $(ls &pluginLOC;/*.txz 2>/dev/null)
</INLINE>
</FILE>

<!-- INSTALACJA PACZKI -->
<FILE Name="&pluginLOC;/custom-vm-icons-&version;.txz" Run="upgradepkg --install-new">
<URL>&packageURL;</URL>
<MD5>&packageMD5;</MD5>
</FILE>

<!-- POST-INSTALL: katalog VM Managera + synchronizacja (tylko przy zamontowanym /mnt/user) -->
<FILE Run="/bin/bash">
<INLINE>
mkdir -p /boot/config/plugins/dynamix.vm.manager/templates/images
chmod +x &emhttpLOC;/scripts/sync_icons.sh &emhttpLOC;/event/disks_mounted
# starsze wersje dopisywaly sync do /boot/config/go (uruchamial sie przed startem tablicy);
# teraz robi to event/disks_mounted, wiec usun stary wpis (zapis na flash tylko gdy wpis istnieje)
if grep -q 'custom-vm-icons/scripts/sync_icons.sh' /boot/config/go 2>/dev/null; then
  sed -i '/custom-vm-icons\/scripts\/sync_icons.sh/d' /boot/config/go
fi
# przywroc brakujace ikony juz teraz - tylko gdy udzialy sa zamontowane
# (przy starcie systemu plugin instaluje sie przed tablica; wtedy zrobi to event/disks_mounted)
if mountpoint -q /mnt/user; then
  bash &emhttpLOC;/scripts/sync_icons.sh --boot || true
fi
echo ""
echo "-------------------------------------------"
echo " custom-vm-icons &version; zainstalowany."
echo " Zarzadzanie ikonami: Ustawienia -> Custom VM Icons"
echo " Katalog trwaly: /mnt/user/appdata/custom-vm-icons"
echo "-------------------------------------------"
echo ""
</INLINE>
</FILE>

<!-- AKTUALIZACJA -->
<FILE Run="/bin/bash" Method="update">
<INLINE>
removepkg &name; 2>/dev/null
</INLINE>
</FILE>

<!-- USUNIECIE -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
sed -i '/custom-vm-icons\/scripts\/sync_icons.sh/d' /boot/config/go 2>/dev/null
removepkg &name; 2>/dev/null
echo "custom-vm-icons odinstalowany."
echo "UWAGA: wgrane ikony pozostaly w /mnt/user/appdata/custom-vm-icons i w /boot/config/plugins/dynamix.vm.manager/templates/images"
</INLINE>
</FILE>
</PLUGIN>
